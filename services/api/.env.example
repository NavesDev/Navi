# Rails Server Configuration
RAILS_ENV=development
PORT=3000
RAILS_MAX_THREADS=5

# Database Configuration
# Leave blank to use local PostgreSQL connection parameters defined in config/database.yml,
# or provide a full DATABASE_URL (useful for Docker or cloud database connections like Neon).
# DATABASE_URL=postgres://postgres:local_postgres_password@localhost:5432/api_development
DATABASE_URL=

# CORS and Network Configuration
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# App Features Configuration
# Allow user registration (signups)
ALLOW_SIGNUP=false

# AI Service (OpenAI) Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Background Job Configuration (Solid Queue)
# Set to true to run Solid Queue supervisor inside the web server's Puma process
SOLID_QUEUE_IN_PUMA=true
# JOB_CONCURRENCY=1

# Production Settings (Only required in production)
# SECRET_KEY_BASE=your_secret_key_base_here
# APP_HOSTS=api.yourdomain.com
# RAILS_LOG_LEVEL=info
